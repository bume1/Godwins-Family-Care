# Godwins Family Care — environment example
# Copy to .env and fill in for local development. Never commit real secrets or PHI.
# TEST DATA ONLY until HIPAA-live (AWS/RDS track). See CLAUDE.md for current status.

# --- Core ---
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# --- Default admin (created on first boot if missing) ---
DEFAULT_ADMIN_EMAIL=admin@godwinsfamilycarell.com
DEFAULT_ADMIN_NAME=GFC Admin
DEFAULT_ADMIN_PASSWORD=change-me

# --- Datastore ---
# Replit KV connection URL (provided by the Replit runtime).
# REPLIT_DB_URL=

# --- Session 3.3, Scope C: care-tier enum migration ---
# One-shot startup migration rewrites legacy careTier 1|2|3 -> A1|A2|A4.
# Leave false (or unset) to let it run once; after it logs success, set to
# true so it does not re-run on every boot.
CARE_TIER_MIGRATION_APPLIED=false

# --- Google Drive integration (Replit connector) ---
# REPLIT_CONNECTORS_HOSTNAME=

# PHI documents (ROI PDFs, signed consents, offline intake packets, service
# reports) must NOT be world-readable by default. Only set true in a non-PHI
# context — never with real PHI.
DRIVE_ALLOW_ANYONE_LINK=false

# --- Transfer-of-Care Provider ROI (Session 3.4) ---
# Legacy Drive + Google Sheet parallel-run sync, on by default during the
# parallel-run window.
PARALLEL_LEGACY_SYNC=true
# ROI_DRIVE_FOLDER_NAME=GFC Provider ROI Uploads
# ROI_ADMIN_EMAIL=admin@godwinsfamilycarellc.com
# ROI_LEGACY_SHEET_ID=
# ROI_LEGACY_SHEET_TAB=Assessments & Intakes

# --- OpenEMR FHIR integration (Sessions 4.1/4.2) ---
# One patient record lives in OpenEMR; the app is a front end over it.
# Reads via FHIR R4; clinical writes via the standard REST API (approved
# transport deviation — OpenEMR 7.0.4 FHIR is read-only for clinical
# resources). Credentials live ONLY in env/secrets.
OPENEMR_BASE_URL=https://emr.godwinsfamilycarellc.com
OPENEMR_SITE=default
# Confidential OAuth2 client registered in OpenEMR (Administration -> System ->
# API Clients). Must be registered with the full 4.1+4.2 scope set (see
# config.js OPENEMR.SCOPES — 4.2 added user/appointment.read,
# user/appointment.write, user/Appointment.read) and ENABLED by an admin.
# OpenEMR cannot widen a client's scopes after registration — adding scopes
# means registering a successor client and swapping these two values (done
# 08/2026 for the appointment scopes).
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=
# Dev-window headless auth: OAuth2 password grant with a dedicated API user
# ("Enable OAuth2 Password Grant" must be on in Administration -> Globals ->
# Connectors). The user needs a clinician-grade ACL group (encounters/notes,
# patient docs). TEST INSTANCE / TEST DATA ONLY.
# Migration to authorization_code + refresh_token is a Session 5 scope item.
OPENEMR_API_USERNAME=
OPENEMR_API_PASSWORD=
# Optional override of the requested scope set (space-separated):
# OPENEMR_SCOPES=

# --- Integrations (optional in dev) ---
# HUBSPOT_WEBHOOK_SECRET=
# RESEND_API_KEY=
# BCRYPT_SALT_ROUNDS=10

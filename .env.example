# Godwins Family Care — environment example
# Copy to .env and fill in for local development. Never commit real secrets or PHI.
# TEST DATA ONLY until HIPAA-live (AWS/RDS track). See CLAUDE.md for current status.

# --- Core ---
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# --- Default admin (created on first boot if missing) ---
DEFAULT_ADMIN_EMAIL=admin@godwinsfamilycarell.com
DEFAULT_ADMIN_NAME=GFC Admin
DEFAULT_ADMIN_PASSWORD=change-me

# --- Datastore ---
# Replit KV connection URL (provided by the Replit runtime).
# REPLIT_DB_URL=

# --- Session 3.3, Scope C: care-tier enum migration ---
# One-shot startup migration rewrites legacy careTier 1|2|3 -> A1|A2|A4.
# Leave false (or unset) to let it run once; after it logs success, set to
# true so it does not re-run on every boot.
CARE_TIER_MIGRATION_APPLIED=false

# --- Google Drive integration (Replit connector) ---
# REPLIT_CONNECTORS_HOSTNAME=

# PHI documents (ROI PDFs, signed consents, offline intake packets, service
# reports) must NOT be world-readable by default. Only set true in a non-PHI
# context — never with real PHI.
DRIVE_ALLOW_ANYONE_LINK=false

# --- Transfer-of-Care Provider ROI (Session 3.4) ---
# Legacy Drive + Google Sheet parallel-run sync, on by default during the
# parallel-run window.
PARALLEL_LEGACY_SYNC=true
# ROI_DRIVE_FOLDER_NAME=GFC Provider ROI Uploads
# ROI_ADMIN_EMAIL=admin@godwinsfamilycarellc.com
# ROI_LEGACY_SHEET_ID=
# ROI_LEGACY_SHEET_TAB=Assessments & Intakes

# --- Integrations (optional in dev) ---
# HUBSPOT_WEBHOOK_SECRET=
# RESEND_API_KEY=
# BCRYPT_SALT_ROUNDS=10
